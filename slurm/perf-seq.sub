#!/bin/bash
#SBATCH -N 1 # number of nodes
#SBATCH --exclusive
#SBATCH --partition=nodo.q
#SBATCH --output=results/output-%j.out
#SBATCH --error=results/output-%j.err

module add gcc/13.2.1

BUILD=release
TARGET=neural_net
EXEC=build/$BUILD-par/$TARGET

# gcc -Ofast main.c common/common.c configuration/config.c layer/layer.c randomizer/randomizer.c initialize/initialize.c training/training.c -o exec -lm 
make clean
make BUILD=$BUILD PAR=0 || exit 1

# TODO Veure documentació de perf stat:
# https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/8/html/monitoring_and_managing_system_status_and_performance/counting-events-during-process-execution-with-perf-stat_monitoring-and-managing-system-status-and-performance
# per millorar i exprimir les seves capacitats
perf stat ./$EXEC configuration/configfile.txt

make clean
